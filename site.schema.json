{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adamgolec675-bit.github.io/histary/site.schema.json",
  "title": "Zabytek histARy",
  "description": "Opis pojedynczego zabytku w katalogu histARy (schemat w wersji 1). Ścieżki względne są liczone od katalogu głównego GitHub Pages.",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "location", "title", "description"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Stały identyfikator, używany w kodzie QR i w nazwie pliku <id>.json."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Numer wersji danych. Zwiększ go po każdej zmianie, aby aplikacja pobrała nowe dane."
    },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "title": { "$ref": "#/$defs/localizedText" },
    "subtitle": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "image": {
      "type": ["object", "null"],
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "Adres https:// lub ścieżka względna." },
        "credit": { "type": "string", "description": "Autor lub źródło zdjęcia." }
      }
    },
    "ar": {
      "type": ["object", "null"],
      "description": "Dane modelu AR. Wartość null oznacza, że zabytek nie ma jeszcze modelu – przycisk AR jest wtedy ukryty.",
      "additionalProperties": false,
      "anyOf": [{ "required": ["glb"] }, { "required": ["usdz"] }],
      "properties": {
        "glb": { "type": "string", "description": "Model glTF Binary dla Androida (WebXR) i podglądu 3D." },
        "usdz": { "type": "string", "description": "Model USDZ dla iOS (AR Quick Look)." },
        "poster": { "type": "string", "description": "Obraz podglądu modelu." },
        "realWidthMeters": { "type": "number", "exclusiveMinimum": 0, "description": "Rzeczywista szerokość budowli w metrach (tryb 1:1)." },
        "tabletopWidthMeters": { "type": "number", "exclusiveMinimum": 0, "description": "Szerokość makiety na stole w metrach." }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["pl"],
      "additionalProperties": false,
      "properties": {
        "pl": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
